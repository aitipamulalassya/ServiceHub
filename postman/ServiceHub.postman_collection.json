{
  "info": {
    "_postman_id": "servicehub-api-collection",
    "name": "ServiceHub API Collection",
    "description": "Postman collection for ServiceHub APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "providerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "providerId",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Provider",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Kumar\",\n  \"email\": \"rahul@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Login Provider / Admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/google",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"credential\": \"PASTE_GOOGLE_CREDENTIAL_HERE\"\n}"
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/forgot-password",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahul@example.com\"\n}"
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/auth/reset-password/{{resetToken}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"newpassword123\",\n  \"confirmPassword\": \"newpassword123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Provider",
      "item": [
        {
          "name": "Get Provider Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/providers/profile",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              }
            ]
          }
        },
        {
          "name": "Update Provider Profile",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/providers/profile",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\",\n  \"categories\": [\n    \"Plumbing\",\n    \"Electrical\"\n  ],\n  \"skills\": [\n    \"Pipe fitting\",\n    \"Wiring\"\n  ],\n  \"experience\": 3,\n  \"location\": {\n    \"city\": \"Hyderabad\",\n    \"state\": \"Telangana\",\n    \"pincode\": \"500001\"\n  }\n}"
            }
          }
        },
        {
          "name": "Submit Provider Application",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/providers/submit",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              }
            ]
          }
        },
        {
          "name": "Get Application Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/providers/status",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Upload Verification Document",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/providers/documents",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "type",
                  "value": "aadhaar",
                  "type": "text"
                },
                {
                  "key": "document",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          }
        },
        {
          "name": "Get Provider Documents",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/providers/documents",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              }
            ]
          }
        },
        {
          "name": "Upload Profile Photo",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/providers/documents/profile-photo",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{providerToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "profilePhoto",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/stats",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ]
          }
        },
        {
          "name": "Get All Providers",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/providers",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ]
          }
        },
        {
          "name": "Get Provider By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/admin/providers/{{providerId}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ]
          }
        },
        {
          "name": "Approve Provider",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/providers/{{providerId}}/approve",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ]
          }
        },
        {
          "name": "Reject Provider",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/admin/providers/{{providerId}}/reject",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionRemark\": \"Please upload a clearer verification document.\"\n}"
            }
          }
        }
      ]
    }
  ]
}